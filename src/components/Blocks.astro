---
/**
 * Content-area renderer: one block instance in, one rendered section out.
 *
 * The registry below maps a content type NAME to a component. Every block type
 * that ships with Paperboy has one; anything else falls through to
 * GenericBlock, which renders from the delivered schema. That fallback is not a
 * nicety — content types are data in Paperboy, so a type someone adds in the
 * admin this afternoon must not render blank on your site.
 *
 * To design a new type: write the component, add one line to REGISTRY. Nothing
 * else in the app needs to know it exists.
 *
 * The `data-pb-*` markers are emitted here, once, for every block — so each
 * component stays free of editing plumbing, and a click in the CMS preview is
 * scoped to the right block. Preview only; public pages carry no markers.
 */
import { blockData, type AreaBlock } from "@paperboycms/client";
import PaperboyForm from "./PaperboyForm.astro";
import TeaserCard from "./TeaserCard.astro";
import AccordionBlock from "./blocks/AccordionBlock.astro";
import AccordionItemBlock from "./blocks/AccordionItemBlock.astro";
import BannerBlock from "./blocks/BannerBlock.astro";
import FaqTopicBlock from "./blocks/FaqTopicBlock.astro";
import GenericBlock from "./blocks/GenericBlock.astro";
import HeroBlock from "./blocks/HeroBlock.astro";
import ImageBlock from "./blocks/ImageBlock.astro";
import LinkItemBlock from "./blocks/LinkItemBlock.astro";
import LinkListBlock from "./blocks/LinkListBlock.astro";
import PersonBlock from "./blocks/PersonBlock.astro";
import QuestionBlock from "./blocks/QuestionBlock.astro";
import QuoteBlock from "./blocks/QuoteBlock.astro";
import TeaserListBlock from "./blocks/TeaserListBlock.astro";
import TextBlock from "./blocks/TextBlock.astro";
import VideoBlock from "./blocks/VideoBlock.astro";
import { pbBlock } from "../lib/editing";
import { teaserFrom } from "../lib/teaser";

interface Props {
  blocks: AreaBlock[];
  preview?: boolean;
  /** Nesting depth, so a block cycle cannot render forever. */
  depth?: number;
}
const { blocks, preview = false, depth = 0 } = Astro.props;

/** Content type name -> component. The one place to register a design. */
const REGISTRY: Record<string, any> = {
  HeroBlock,
  TextBlock,
  ImageBlock,
  QuoteBlock,
  BannerBlock,
  VideoBlock,
  TeaserListBlock,
  AccordionBlock,
  AccordionItemBlock,
  FaqTopicBlock,
  QuestionBlock,
  PersonBlock,
  LinkListBlock,
  LinkItemBlock,
};

/** Field types for THIS block: inline blocks carry their own, shared blocks
 *  carry the resolved document's. */
const typesOf = (b: AreaBlock): Record<string, string> =>
  (b.shared ? b.content?.fieldTypes : b.fieldTypes) ?? {};

/** The type name to render by — a shared block's real type lives on `content`. */
const typeOf = (b: AreaBlock): string => (b.shared ? b.content?.type : undefined) ?? b.blockType;
---

{blocks.map((b, i) => {
  const type = typeOf(b);
  const data = blockData(b);
  const Component = REGISTRY[type];
  const attrs = pbBlock(i, b.blockType, preview);

  // A FORM is a shared block whose delivered document carries a `form` spec:
  // fields, labels, validation rules and the editor's own error copy. It needs
  // real inputs, so it cannot come out of a field loop.
  if (b.shared && b.content?.form && b.content.documentId) {
    return (
      <section class="pb-block pb-block--form" {...attrs}>
        <div class="pb-panel">
          <PaperboyForm spec={b.content.form} formId={b.content.documentId} />
        </div>
      </section>
    );
  }

  // A PAGE dropped into an area is a teaser for that page, not a block.
  if (b.shared && b.content?.kind === "page") {
    const teaser = teaserFrom(b);
    if (!teaser.title && !teaser.text) return null;
    return (
      <section class="pb-block pb-block--teaser" {...attrs}>
        <div class="pb-grid">
          <TeaserCard href={teaser.href} title={teaser.title} text={teaser.text} image={teaser.image} />
        </div>
      </section>
    );
  }

  return (
    <section class={`pb-block pb-block--${type.toLowerCase()}`} {...attrs}>
      {Component ? (
        <Component data={data} preview={preview} />
      ) : (
        <GenericBlock data={data} types={typesOf(b)} preview={preview} depth={depth} />
      )}
    </section>
  );
})}

{blocks.length === 0 && preview && (
  /* An empty area renders no DOM, which in the CMS preview means there is
     nothing to drop a block onto. Give the editor a target — preview only. */
  <p class="pb-empty-area">Empty area — drop a block here.</p>
)}

<style>
  .pb-empty-area {
    padding: 2rem;
    border: 2px dashed var(--pb-muted);
    border-radius: var(--pb-radius-control);
    text-align: center;
    color: var(--pb-muted);
    font-style: italic;
  }
</style>
