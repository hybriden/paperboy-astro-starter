---
/**
 * A Paperboy form, rendered from the spec the Delivery API attaches to a Form
 * block. Delivery sends a SCHEMA, never markup, so the styling is entirely
 * yours — labels, requiredness, lengths, options and error copy all come from
 * the CMS and change without a deploy.
 *
 * `fieldAttrs` builds accessible attributes from the spec (label association,
 * `aria-describedby` for help and error text, programmatic `required`), and
 * `honeypotAttrs` builds the hidden anti-spam field — hidden from sight AND from
 * assistive tech, and never focusable.
 *
 * The submit goes to this app's own /api/submit, which forwards to the CMS. That
 * server hop exists so the CMS validates against the CURRENT published form
 * definition: the rules the visitor was shown are the rules actually enforced.
 *
 * Works WITHOUT JavaScript, on purpose. With JS it submits in the background and
 * puts each error beside its field; without, it is a plain POST that redirects
 * back here with a message instead of showing raw JSON. Two details make the
 * no-JS path honest:
 *
 *  - `pb_rendered_at` is stamped server-side, so the CMS's minimum-fill-time
 *    spam check has a real duration to judge. It used to depend on a JS timer,
 *    which meant a JS-less visitor submitted 0ms and had a genuine enquiry
 *    silently discarded as spam while being told it was sent.
 *  - `pb_return_to` says where to come back to, rather than trusting Referer.
 */
import { fieldAttrs, honeypotAttrs, isRichTextDoc, renderRichText, type FormSpec } from "@paperboycms/client";

interface Props {
  spec: FormSpec;
  /** The Form's documentId — submissions are posted against it. */
  formId: string;
}
const { spec, formId } = Astro.props;
const honeypot = honeypotAttrs(spec);

// State for the no-JS round trip. Keyed by form so two forms on one page cannot
// claim each other's outcome.
const token = String(formId).slice(0, 8);
const sent = Astro.url.searchParams.get("sent") === token;
const failed = Astro.url.searchParams.get("formError") === token;
const renderedAt = Date.now();
const introHtml = isRichTextDoc(spec.intro) ? renderRichText(spec.intro) : "";
const returnTo = Astro.url.pathname;
---

{/* novalidate on purpose. The CMS is the authority on these rules, and the
    browser's own bubbles fire BEFORE any script runs — so with native validation
    on, a visitor saw "Please tick this box if you want to proceed" and never the
    editor's own wording, which is the thing this form exists to demonstrate.
    Every field still carries required/type for assistive tech and for the
    server; only the browser's own UI is suppressed. */}
<form class="pb-form" method="POST" action="/api/submit" data-paperboy-form novalidate>
  <input type="hidden" name="pb_form_id" value={formId} />
  <input type="hidden" name="pb_honeypot_field" value={spec.honeypotField} />
  <input type="hidden" name="pb_elapsed_ms" value="0" data-paperboy-elapsed />
  <input type="hidden" name="pb_rendered_at" value={String(renderedAt)} />
  <input type="hidden" name="pb_return_to" value={returnTo} />

  {spec.title && <h2>{spec.title}</h2>}
  {/* The editor's own introduction. Delivered as richtext on the spec and, until
      now, quietly discarded — the exact failure this codebase has rules about. */}
  {introHtml && <div class="pb-form__intro pb-prose" set:html={introHtml} />}

  {/* One live region for the whole form, so a screen reader hears the outcome
      instead of hunting for it. The no-JS round trip lands here too. */}
  <p
    class:list={["pb-form__status", sent && "pb-form__status--ok", failed && "pb-form__status--bad"]}
    role="status"
    aria-live="polite"
    data-paperboy-status
    hidden={!sent && !failed}
  >
    {sent
      ? "Thanks \u2014 your message has been sent."
      : failed
        ? "Please check the highlighted fields and try again."
        : ""}
  </p>

  {spec.fields.map((field) => {
    // Static text collects no answer — it is copy between questions.
    if (field.kind === "static") {
      return field.heading ? <h3 class="pb-form__heading">{field.heading}</h3> : null;
    }
    const a = fieldAttrs(field, { idPrefix: `pb-${formId}` });
    return (
      <div class:list={["pb-form__field", (field.kind === "checkbox" || field.kind === "consent") && "pb-form__field--inline"]}>
        <label for={a.id}>
          {field.label}
          {field.required && <span class="pb-form__req" aria-hidden="true"> *</span>}
        </label>

        {field.kind === "textarea" ? (
          <textarea {...a.input} />
        ) : field.kind === "select" ? (
          <select id={a.id} name={a.name} required={a.required || undefined} aria-describedby={a.describedBy}>
            <option value="">Choose…</option>
            {(field.choices ?? []).map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
        ) : field.kind === "radio" ? (
          <fieldset class="pb-form__choices">
            <legend class="pb-visually-hidden">{field.label}</legend>
            {(field.choices ?? []).map((c, i) => (
              <label class="pb-form__choice" for={`${a.id}-${i}`}>
                <input type="radio" id={`${a.id}-${i}`} name={a.name} value={c.value} required={a.required || undefined} />
                <span>{c.label}</span>
              </label>
            ))}
          </fieldset>
        ) : (
          <input {...a.input} />
        )}

        {field.helpText && <p class="pb-form__help" id={a.helpId}>{field.helpText}</p>}
        {/* Filled in from the CMS's per-field messages: the editor's own words,
            beside the input they belong to (WCAG 3.3.1). */}
        <p class="pb-form__error" data-paperboy-error={field.name} hidden></p>
      </div>
    );
  })}

  {/* Invisible to people, irresistible to bots. */}
  <div style={honeypot.wrapperStyle} aria-hidden="true" inert>
    <label for={`pb-${formId}-hp`}>Leave this field empty</label>
    <input {...honeypot.input} id={`pb-${formId}-hp`} />
  </div>

  <button class="pb-btn pb-btn--accent pb-form__submit" type="submit">{spec.submitLabel || "Send"}</button>
</form>

<script>
  // Progressive enhancement. Without this the form is a plain POST that
  // redirects back with a status message; with it the visitor stays on the page
  // and every error appears beside its own field.
  const bind = () => {
    document.querySelectorAll<HTMLFormElement>("form[data-paperboy-form]").forEach((form) => {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";
      const opened = Date.now();

      const status = form.querySelector<HTMLElement>("[data-paperboy-status]");
      const say = (text: string, ok: boolean) => {
        if (!status) return;
        status.textContent = text;
        status.hidden = false;
        status.classList.toggle("pb-form__status--ok", ok);
        status.classList.toggle("pb-form__status--bad", !ok);
      };
      const clearErrors = () => {
        form.querySelectorAll<HTMLElement>("[data-paperboy-error]").forEach((el) => {
          el.textContent = "";
          el.hidden = true;
        });
        // Also the status: a second, rejected attempt used to sit under the
        // "Thank you" from the first one, telling the visitor their message was
        // in when it had just been refused.
        if (status) {
          status.textContent = "";
          status.hidden = true;
          status.classList.remove("pb-form__status--ok", "pb-form__status--bad");
        }
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearErrors();

        const elapsed = form.querySelector<HTMLInputElement>("input[data-paperboy-elapsed]");
        if (elapsed) elapsed.value = String(Date.now() - opened);

        const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
        const label = button ? button.textContent : "";
        if (button) {
          button.disabled = true;
          button.textContent = "Sending...";
        }

        try {
          const res = await fetch(form.action, {
            method: "POST",
            headers: { accept: "application/json" },
            body: new FormData(form),
          });
          const body = await res.json().catch(() => ({}));

          if (res.ok) {
            form.reset();
            say(typeof body.message === "string" ? body.message : "Thanks \u2014 your message has been sent.", true);
            return;
          }

          const fields = (body.fields || {}) as Record<string, string>;
          let first: HTMLElement | null = null;
          for (const [name, message] of Object.entries(fields)) {
            const slot = form.querySelector<HTMLElement>('[data-paperboy-error="' + name + '"]');
            if (slot) {
              slot.textContent = message;
              slot.hidden = false;
            }
            if (!first) first = form.querySelector<HTMLElement>('[name="' + name + '"]');
          }
          const generic = typeof body.error === "string" && Object.keys(fields).length === 0
            ? body.error
            : "Please check the highlighted fields and try again.";
          say(generic, false);
          if (first) first.focus();
        } catch {
          say("Your message could not be sent. Please try again.", false);
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = label;
          }
        }
      });
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>

<style>
  /* The form is markup we own — delivery sends a schema, never HTML — so it
     takes the same controls as the rest of the design: 14px radii, a 1px black
     border, and the accent button for the one action that matters. */
  .pb-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 34rem;
  }
  .pb-form > h2 { margin-bottom: 0.25rem; }

  .pb-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pb-form__field > label {
    font-weight: 500;
  }
  .pb-form__req { color: var(--pb-danger); }

  .pb-form__field :is(input, textarea, select):not([type="checkbox"]):not([type="radio"]) {
    width: 100%;
    min-height: 3.5rem;
    padding: 0.75rem 1.25rem;
    font: inherit;
    color: inherit;
    background: var(--pb-white);
    border: var(--pb-border-width) solid var(--pb-line);
    border-radius: var(--pb-radius-control);
  }
  .pb-form__field textarea {
    min-height: 8rem;
    resize: vertical;
  }
  .pb-form__field :is(input, textarea, select)::placeholder { color: #8b8c96; }

  /* A checkbox belongs beside its label, not above it. */
  .pb-form__field--inline {
    /* row-reverse puts the box before its label visually while keeping the
       label first in the DOM. In row-reverse, flex-END is the visual left. */
    flex-direction: row-reverse;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .pb-form__field--inline > label { font-weight: 400; }
  .pb-form__field--inline input[type="checkbox"] {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    flex: 0 0 auto;
    accent-color: var(--pb-dark);
  }

  .pb-form__help {
    margin: 0;
    font-size: var(--pb-text-small);
    color: var(--pb-muted);
  }

  .pb-form__intro {
    color: var(--pb-muted);
  }

  .pb-form__error {
    margin: 0;
    font-size: var(--pb-text-small);
    font-weight: 500;
    color: var(--pb-danger);
  }

  .pb-form__status {
    margin: 0;
    padding: 0.85rem 1.15rem;
    border: var(--pb-border-width) solid var(--pb-line);
    border-radius: var(--pb-radius-control);
  }
  .pb-form__status--ok { background: var(--pb-accent); }
  .pb-form__status--bad { background: #ffe2e0; }

  .pb-form__choices {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pb-form__choice {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 400;
  }
  .pb-form__choice input { accent-color: var(--pb-dark); }

  .pb-form__heading {
    font-size: var(--pb-text-h4);
    margin-top: 0.5rem;
  }

  .pb-form__submit { align-self: flex-start; }

  .pb-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
