---
/**
 * A card that teases another page.
 *
 * Two things produce one of these: a PAGE dropped into a content area (delivery
 * resolves it with `kind: "page"` and a `urlPath`), and a list page listing its
 * children. Both go through this component so a teaser looks the same wherever
 * it comes from.
 *
 * Paperboy's built-in page types carry `teaserTitle` / `teaserText` /
 * `teaserImage` fields precisely so an editor can control how a page appears
 * elsewhere — those win over the page's own heading when set.
 */
import { mediaSrcset, mediaUrl } from "@paperboycms/client";
import type { PbImage } from "../lib/values";

interface Props {
  href?: string | null;
  title: string;
  text?: string;
  image?: PbImage | null;
  /** Cycled by grids so a row of cards alternates like the design does. */
  tone?: "white" | "grey" | "accent" | "dark";
  eyebrow?: string;
}

const { href, title, text = "", image = null, tone = "white", eyebrow = "" } = Astro.props;

const toneClass = {
  white: "",
  grey: "pb-card--grey",
  accent: "pb-card--accent",
  dark: "pb-card--dark",
}[tone];

// A teaser with nowhere to go is still worth rendering (it shows the editor
// something is there), but it must not become a link to the current page.
const Tag = href ? "a" : "div";
---

<Tag class={`pb-card pb-teaser ${toneClass} ${image ? "" : "pb-teaser--textonly"}`} href={href ?? undefined}>
  {/* The photograph is DECORATIVE here, deliberately: it sits inside the card's
      own link, so alt text would be prepended to the link's accessible name —
      "Hands sketching a diagram… Design systems One set of components…". The
      heading beside it already says where the link goes. */}
  {image && (
    <img
      class="pb-teaser__img"
      src={mediaUrl(image.url, { w: 640, format: "webp" })}
      srcset={mediaSrcset(image.url, [320, 640, 960])}
      sizes="(max-width: 700px) 100vw, 380px"
      alt=""
      loading="lazy"
      decoding="async"
    />
  )}
  {eyebrow && <p class="pb-eyebrow">{eyebrow}</p>}
  <h3 class="pb-teaser__title">{title}</h3>
  {text && <p class="pb-teaser__text">{text}</p>}
  {href && (
    <span class="pb-arrow-link pb-teaser__more">
      <span class="pb-arrow-link__dot" aria-hidden="true">&#8599;</span>
      <span>Read more</span>
    </span>
  )}
</Tag>

<style>
  .pb-teaser {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    /* Fill the grid row, so every card in it ends level. */
    height: 100%;
  }
  a.pb-teaser:hover {
    box-shadow: var(--pb-shadow-press);
    transform: translateY(3px);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  /* The photograph bleeds to the card's own edges rather than sitting inside
     the padding, which reads as a thumbnail someone dropped in. The top corners
     follow the card's radius; 1px in, so the border still draws cleanly. */
  .pb-teaser__img {
    display: block;
    width: calc(100% + 2 * var(--pb-card-pad));
    /* The global `img { max-width: 100% }` clamps that calc back to the
       content box, so the photograph bled left and stopped short on the right. */
    max-width: none;
    margin: calc(-1 * var(--pb-card-pad)) calc(-1 * var(--pb-card-pad)) 0.5rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    /* Top-biased, because these are photographs of people: a centred crop of a
       16:10 window takes the middle and cuts the top of the head off. */
    object-position: 50% 30%;
    border-radius: calc(var(--pb-radius-card) - 1px) calc(var(--pb-radius-card) - 1px) 0 0;
  }
  .pb-teaser__text {
    color: inherit;
    opacity: 0.85;
  }
  .pb-teaser__more { margin-top: auto; }
  /* Without a photograph, `margin-top: auto` pooled ALL the slack in one place:
     245px of nothing between the text and "Read more", in the band where the
     next card shows its picture — which reads as an image that failed to load.
     Centring splits it above and below, and the card becomes a typographic
     tile on purpose. */
  .pb-teaser--textonly { justify-content: center; }
  .pb-teaser--textonly .pb-teaser__more { margin-top: 1rem; }
</style>
