---
/**
 * LinkItemBlock — a single link.
 *
 * Used for menus, footer columns and link lists, so it is deliberately just a
 * link with the design's green arrow dot. An internal link whose target is
 * unpublished arrives with an empty href, and renders as plain text rather than
 * as a link to nowhere.
 */
import { linkState } from "../../lib/current-link";
import { link, linkText, type Data } from "../../lib/values";

interface Props {
  data: Data;
  preview?: boolean;
  /** "arrow" for a list row, "plain" for a nav item. */
  variant?: "arrow" | "plain";
}
const { data, variant = "arrow" } = Astro.props;

const l = link(data, "link");
// The label is read separately from the href: an internal link to something
// unpublished has no href, but the editor still typed a label and losing it
// would make the item vanish from the menu with no explanation.
const label = linkText(data, "link") || l?.href || "";

// "page" when this IS the page you are on, "section" when you are somewhere
// under it. Only the first is aria-current="page" — on an article you are under
// Journal, not on it, and saying otherwise to a screen reader is a lie that
// costs nothing to avoid. See lib/current-link.ts for the locale and home cases.
const state = linkState(l?.href, Astro.url.pathname);
---

{l ? (
  variant === "arrow" ? (
    <a class="pb-arrow-link" href={l.href} target={l.target ?? undefined} title={l.title ?? undefined}>
      <span class="pb-arrow-link__dot" aria-hidden="true">&#8599;</span>
      <span>{label}</span>
    </a>
  ) : (
    <a
      href={l.href}
      target={l.target ?? undefined}
      title={l.title ?? undefined}
      aria-current={state === "page" ? "page" : undefined}
      data-state={state}
    >{label}</a>
  )
) : (
  label && <span class="link-item--dead">{label}</span>
)}

<style>
  /* Not a link: the target isn't published (or is missing). Visible to an
     editor in preview, unremarkable to a visitor. */
  .link-item--dead { color: var(--pb-muted); }

  /* Where you are. A 2px rule under the word rather than an underline, because
     hover already owns the 1px underline and two things that look the same are
     two things you cannot tell apart. The section state is the same mark at half
     strength: enough to point at the right menu item from inside an article. */
  a[data-state] {
    font-weight: 600;
    box-shadow: inset 0 -2px 0 0 currentColor;
  }
  a[data-state="section"] {
    font-weight: 500;
    box-shadow: inset 0 -2px 0 0 color-mix(in srgb, currentColor 35%, transparent);
  }
</style>
