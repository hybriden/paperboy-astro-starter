---
/**
 * BannerBlock — heading, text, one action, optional background image.
 *
 * The design's call-to-action panel: grey by default, and dark with the image
 * behind it when a background image is set (white text needs the dark ground to
 * stay legible over a photo).
 */
import { mediaUrl } from "@paperboycms/client";
import { pbField } from "../../lib/editing";
import { img, link, linkLabel, str, type Data } from "../../lib/values";

interface Props {
  data: Data;
  preview?: boolean;
}
const { data, preview = false } = Astro.props;

const heading = str(data, "heading");
const text = str(data, "text");
const action = link(data, "link");
const bg = img(data, "backgroundImage");
const bgUrl = bg ? mediaUrl(bg.url, { w: 1600, format: "webp" }) : null;
---

<div
  class:list={["banner", "pb-panel", bgUrl && "pb-panel--dark", bgUrl && "banner--image"]}
  style={bgUrl ? `background-image: url(${JSON.stringify(bgUrl)})` : undefined}
>
  <div class="banner__text">
    {heading && <h2 {...pbField("heading", preview)}>{heading}</h2>}
    {text && <p class="banner__lead" {...pbField("text", preview)}>{text}</p>}
  </div>
  {action && (
    <a
      class:list={["pb-btn", bgUrl ? "pb-btn--accent" : "pb-btn"]}
      href={action.href}
      target={action.target ?? undefined}
    >
      {linkLabel(action, "Get in touch")}
    </a>
  )}
</div>

<style>
  .banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pb-gap-lg);
  }
  .banner__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 48ch;
  }
  .banner__lead { font-size: var(--pb-text-lead); }
  /* A photo behind text needs a scrim, or the contrast depends on the photo. */
  .banner--image {
    position: relative;
    background-size: cover;
    background-position: center;
    isolation: isolate;
  }
  .banner--image::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, rgba(25, 26, 35, 0.92), rgba(25, 26, 35, 0.55));
    z-index: -1;
  }
</style>
