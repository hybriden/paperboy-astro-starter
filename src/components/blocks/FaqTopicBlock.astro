---
/**
 * FaqTopicBlock — a named group of questions.
 *
 * The topic is an h2: it sits directly under the FAQ page's own h1, and an h3
 * there skips a level. Keeping the outline intact is what lets a screen-reader
 * user jump between topics.
 */
import { blockData, pbAreaAttrs, type AreaBlock } from "@paperboycms/client";
import QuestionBlock from "./QuestionBlock.astro";
import { pbField } from "../../lib/editing";
import { area, str, type Data } from "../../lib/values";

interface Props {
  data: Data;
  preview?: boolean;
}
const { data, preview = false } = Astro.props;

const topic = str(data, "topic");
const questions: AreaBlock[] = area(data, "questions");
---

<section class="faq-topic">
  {topic && (
    <h2 class="faq-topic__title">
      <span class="pb-highlight" {...pbField("topic", preview)}>{topic}</span>
    </h2>
  )}
  <div class="pb-accordion" {...pbAreaAttrs("questions", preview)}>
    {questions.map((q, i) => (
      /* The first answer of each topic is open, so the page shows what is inside
         it rather than five closed bars — the same call the home page's
         accordion makes for its first row. */
      <QuestionBlock data={blockData(q)} preview={preview} open={i === 0} />
    ))}
  </div>
</section>

<style>
  .faq-topic__title { margin-bottom: var(--pb-gap); }
</style>
