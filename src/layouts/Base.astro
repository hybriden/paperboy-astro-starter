---
/**
 * Page shell: head, chrome, and the slot your page renders into.
 *
 * The head is assembled from Paperboy's computed `seo` block, which every PAGE
 * item carries: meta, canonical, robots, OpenGraph, Twitter, JSON-LD and a
 * breadcrumb trail, derived from the `seoRole` / `schemaProp` your content types
 * declare. It is computed AFTER field visibility is applied, so a private field
 * can never leak into a meta tag.
 *
 * The type comes from the client package rather than being re-declared here.
 * Three details are easy to get wrong by hand and all three fail SILENTLY:
 *   canonicalPath  a PATH, so an origin has to be prefixed
 *   og.image       an OBJECT {url, alt}, not a string — a naive loop emits
 *                  content="[object Object]" and no scraper ever complains
 *   breadcrumb     a plain array of {name, urlPath}; real BreadcrumbList JSON-LD
 *                  has to be BUILT from it, not stringified as-is
 *
 * Header and footer come from the HeaderSettings / FooterSettings globals and
 * are fetched HERE, so every page gets chrome without each route asking for it.
 */
import type { Delivered, DeliverySeo } from "@paperboycms/client";
import PreviewBridge from "../components/PreviewBridge.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { cms, type Env } from "../lib/cms";
import "../styles/app.css";

interface Props {
  seo?: DeliverySeo | null;
  preview?: boolean;
  /** Fallback title for routes with no CMS item behind them (404, errors). */
  title?: string;
  /** Runtime env, passed through so the globals fetch works on any host. */
  env?: Env;
}
const { seo, preview = false, title, env } = Astro.props;

// Prefer the configured `site` in astro.config.mjs (stable behind proxies and
// CDNs); fall back to the request origin so the starter works with no config.
const origin = Astro.site?.origin ?? Astro.url.origin;
const abs = (path: string) => new URL(path, origin).href;
const canonical = seo?.canonicalPath ? abs(seo.canonicalPath) : null;

const og = seo?.og;
const jsonLd = seo?.jsonLd ? JSON.stringify(seo.jsonLd) : null;

// A BreadcrumbList a search engine will actually read: positions from 1, and
// only the steps that are addressable (an unpublished ancestor has urlPath null).
const crumbs = (seo?.breadcrumb ?? []).filter((c) => c.urlPath);
const breadcrumbLd =
  crumbs.length > 1
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: crumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: abs(c.urlPath as string),
        })),
      })
    : null;

/**
 * Chrome. A missing global is normal (nobody has created it yet) and must not
 * take the page down with it, so both fetches fall back to null rather than
 * throwing — a page with no nav still beats a 500.
 */
let header: Delivered | null = null;
let footer: Delivered | null = null;
try {
  const client = cms(env, preview);
  [header, footer] = await Promise.all([
    client.global("HeaderSettings").catch(() => null),
    client.global("FooterSettings").catch(() => null),
  ]);
} catch {
  // No CMS configured yet, or unreachable. A page with no nav still beats a 500
  // — and it means `npm run dev` works before you have filled in .env.
}
const siteName = og?.siteName ?? "Home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{seo?.title ?? title ?? "Paperboy site"}</title>
    {seo?.description && <meta name="description" content={seo.description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Preview is always noindex. The CMS enforces it server-side too — this is
        belt and braces, because a draft reaching an index is unrecoverable. */}
    <meta name="robots" content={preview ? "noindex, nofollow" : (seo?.robots ?? "index, follow")} />

    {og && (
      <>
        <meta property="og:title" content={og.title} />
        {og.description && <meta property="og:description" content={og.description} />}
        <meta property="og:type" content={og.type} />
        {og.siteName && <meta property="og:site_name" content={og.siteName} />}
        {og.image && <meta property="og:image" content={abs(og.image.url)} />}
        {og.image?.alt && <meta property="og:image:alt" content={og.image.alt} />}
        {canonical && <meta property="og:url" content={canonical} />}
      </>
    )}

    {seo?.twitter?.card && <meta name="twitter:card" content={seo.twitter.card} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={breadcrumbLd} />}

    {/* Space Grotesk is the design's typeface. Preconnect so the font request
        starts before the CSS that asks for it; the stack in tokens.css keeps
        the page readable if the request is blocked. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <SiteHeader settings={header} preview={preview} siteName={siteName} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter settings={footer} preview={preview} />
    {preview && <PreviewBridge />}
  </body>
</html>
