# Where your Paperboy instance lives (no trailing slash).
PAPERBOY_API_URL=https://cms.example.com

# Delivery keys, from Settings -> API keys in the admin. Per SITE, so a
# multisite instance has one pair per site.
#   pk_live_...  published content only. Safe for a public frontend.
#   prv_...      published AND drafts. SERVER-SIDE ONLY - never ship it to a browser.
PAPERBOY_PUBLIC_KEY=pk_live_replace_me
PAPERBOY_PREVIEW_KEY=prv_replace_me

# Must be byte-identical to PREVIEW_SECRET on the Paperboy API. The admin asks
# its own API for a short-lived signed token and passes it as ?pbt=; this app
# verifies that signature. The secret itself never reaches a browser.
PREVIEW_SECRET=replace-me-with-the-same-value-as-the-api

# Optional, but set it if you deploy behind a TLS-terminating proxy (Cloudflare
# Tunnel, nginx, a load balancer). The proxy forwards plain HTTP, so the server
# sees http:// and the URLs this site publishes ABOUT ITSELF — og:url, every
# sitemap.xml entry, llms.txt — come out on the wrong scheme. With this set,
# nothing is guessed; without it, the scheme is taken from x-forwarded-proto and
# the host from the request. No trailing slash.
# PUBLIC_SITE_URL=https://www.example.com

# Optional. Which language this deployment serves, e.g. "no". A page's URL is
# per locale (/home in English is /hjem in Norwegian), so one route serves one
# language; unset means the API's default. For a multilingual site, add a
# [locale] segment to the route instead.
# PAPERBOY_LOCALE=en
